[Unit]
Description=Kontent Zavod channel collector
After=network-online.target kontent-zavod.service
Wants=network-online.target
Requires=kontent-zavod.service
PartOf=kontent-zavod.service

[Service]
Type=simple
User=kontentzavod
Group=kontentzavod
WorkingDirectory=/opt/kontent-zavod/current
Environment=NODE_ENV=production
Environment=CONTENT_FACTORY_BASE_URL=http://127.0.0.1:18082
Environment=YTDLP_BIN=/usr/local/bin/yt-dlp
Environment=SYNC_POLL_SECONDS=45
Environment=PARSER_PLAYLIST_LIMIT=120
Environment=PARSER_TIMEOUT_SECONDS=180
EnvironmentFile=/etc/kontent-zavod/sync.env
ExecStart=/opt/kontent-zavod-runtime/node/bin/node /opt/kontent-zavod/current/scripts/channel-sync.mjs
Restart=always
RestartSec=10
TimeoutStopSec=20
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/kontent-zavod/current

MemoryHigh=384M
MemoryMax=512M
TasksMax=48
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
