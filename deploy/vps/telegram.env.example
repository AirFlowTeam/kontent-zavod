# Store the real value in /etc/kontent-zavod/telegram.env on the server.
# File mode: 0640; owner: root; group: kontentzavod.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
TELEGRAM_ACCESS_CODE=replace-with-random-invite-code
# Comma-separated IDs that may open the creator selector without an invite code.
TELEGRAM_ADMIN_USER_IDS=replace-with-telegram-user-id
